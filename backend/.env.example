# Backend-local .env.example — copy to backend/.env for venv/IDE usage outside Docker.
# When running via docker-compose, env comes from the root .env (NOT this file).

DATABASE_URL=postgresql+psycopg://trading_app:CHANGEME@localhost:5432/jayanth_trading
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jayanth_trading
DB_USER=trading_app
DB_PASSWORD=CHANGEME

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Sprint S1 - LLD-aligned env vars (ENV-001 resolution).
API_CORS_ORIGINS=http://localhost:3000
API_ENV=development
