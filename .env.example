# Root .env.example — copy to .env and fill in real values. docker-compose reads this automatically.
# IMPORTANT: .env is gitignored; never commit real secrets.

# Database (used by postgres container AND backend)
DB_NAME=jayanth_trading
DB_USER=trading_app
DB_PASSWORD=CHANGEME_strong_password

# Backend
APP_ENV=development
LOG_LEVEL=INFO

# Sprint S1 - LLD-aligned env vars (ENV-001 resolution). Pydantic-settings reads these into Settings fields.
API_CORS_ORIGINS=http://localhost:3000
API_ENV=development
