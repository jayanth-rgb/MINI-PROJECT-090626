  "numbering_note": "TC IDs start at TC-171. S1 owned TC-001..TC-046 (46 TCs), S2 owned TC-047..TC-114 (68 TCs), S3 owned TC-115..TC-170 (56 TCs). V2 owns TC-171..TC-217 (47 TCs).",
  "ac_definitions": {
    "F-013": {
      "AC-054": "POST /auth/login with valid username + password returns HTTP 200 with access_token (non-empty JWT), token_type='bearer', role.",
      "AC-055": "POST /auth/login with wrong password or unknown username returns HTTP 401.",
      "AC-056": "POST /auth/login for a user with is_active=false returns HTTP 401."
    },
    "F-014": {
      "AC-057": "GET /auth/me with a valid Bearer JWT returns HTTP 200 with the authenticated user's id, username, role, is_active.",
      "AC-058": "All V1 + V2 API endpoints (except POST /auth/login) require a valid Bearer token; unauthenticated requests return HTTP 401.",
      "AC-059": "Endpoints guarded by require_supervisor return HTTP 403 for STAFF and VERIFIER roles; SUPERVISOR requests pass through.",
      "AC-060": "SUPERVISOR can create a new user (POST /users 201) and update an existing user's role/status/password (PATCH /users/{id} 200)."
    },
    "F-015": {
      "AC-061": "GET /reports/inward with no filters returns all inward data; sum(transactions[*].nos) == sum(consolidation[*].total_nos) — reconciliation invariant (DS-017).",
      "AC-062": "Optional multi-select filters (date_from, date_to, supplier_ids, places, design_ids) narrow both consolidation and transaction sections using an identical predicate.",
      "AC-063": "Consolidation section is ordered by design_name ASC then grade_code ASC; transactions section is ordered by purchase_date ASC."
    },
    "F-016": {
      "AC-064": "GET /reports/sales/export?format=pdf returns HTTP 200 StreamingResponse with Content-Type application/pdf and body whose first 5 bytes are '%PDF-'.",
      "AC-065": "GET /reports/inward/export?format=xlsx returns HTTP 200 StreamingResponse with XLSX MIME type and a workbook containing exactly 2 sheets named 'Consolidation' and 'Transactions'.",
      "AC-066": "Requesting an unsupported export format (e.g. format=csv) returns HTTP 400."
    },
    "F-017": {
      "AC-067": "Creating a price with a duplicate (design_id, grade_id, effective_from) triple returns HTTP 409.",
      "AC-068": "Active price lookup returns the most recently effective row (effective_from <= invoice_date ORDER BY DESC LIMIT 1); returns unit_price=0 when no active price exists."
    },
    "F-018": {
      "AC-069": "POST /invoices {sales_header_id} creates invoice with invoice_number='INV-{YYYYMMDD}-{id:05d}', total_amount = sum of line_totals computed from snapshotted unit_price, initial status='PENDING'.",
      "AC-070": "Creating a second invoice for an already-invoiced sale (same sales_header_id) returns HTTP 409.",
      "AC-071": "Invoice line unit_price is a point-in-time snapshot at creation; subsequent price master edits do not alter the invoice."
    },
    "F-019": {
      "AC-072": "POST /invoices/{id}/payments records the payment and recomputes status: 0 paid → PENDING, partial sum → PARTIAL, full sum → PAID.",
      "AC-073": "Recording a payment that would cause cumulative payments to exceed invoice total_amount returns HTTP 422."
    },
    "DS-020": {
      "AC-074": "Concurrent first-row inserts to tbl_stock_ledger for the same (design_id, grade_id) are serialized by pg_advisory_xact_lock; exactly one row is created with the correct cumulative running_balance and no IntegrityError occurs (TD-008 closed by DS-015)."
    }
  },
