      "description": "Two concurrent threads each calling domain.stock._apply on an empty ledger for (design_id=1, grade_id=1) with deltas 50 and 30 produce exactly 1 ledger row with running_balance=80 — no IntegrityError from first-row insert race (TD-008 / DS-015 advisory lock).",
      "type": "integration",
      "priority": "critical",
      "file_ref": "backend/src/domain/stock.py",
      "function_ref": "_apply (via domain.stock advisory lock path)",
      "inputs": {
        "initial_ledger_state": "empty — no row exists for (design_id=1, grade_id=1)",
        "thread_1": {
          "design_id": 1,
          "grade_id": 1,
          "delta": 50,
          "txn_date": "2026-07-02",
          "txn_type": "inward"
        },
        "thread_2": {
          "design_id": 1,
          "grade_id": 1,
          "delta": 30,
          "txn_date": "2026-07-02",
          "txn_type": "inward"
        },
        "concurrency": "both threads started simultaneously via threading.Thread with barrier sync before commit"
      },
      "expected_output": {
        "ledger_row_count_for_design_1_grade_1": 1,
        "final_running_balance": 80,
        "no_integrity_error": true,
        "no_duplicate_key_error": true
      },
      "expected_side_effects": [
        "pg_advisory_xact_lock serializes the two concurrent writes",
        "second writer sees first writer's row via SELECT FOR UPDATE after advisory lock acquired"
      ],
      "framework": "pytest"
    },
