{
  "$schema": "ases/v3.0/deps_manifest",
  "document": "deps_manifest",
  "produced_by": "/ases-lld",
  "consumed_by": ["/ases-analyze", "/ases-sprint-scaffold"],
  "sprint_id": "S1",
  "packages": [
    {
      "name": "fastapi",
      "version": "0.115.6",
      "type": "runtime",
      "required_by": ["backend/src/main.py", "backend/src/presentation/api/routers/*.py"],
      "install_cmd": "pip install fastapi==0.115.6"
    },
    {
      "name": "uvicorn",
      "version": "0.34.0",
      "type": "runtime",
      "required_by": ["backend/src/main.py"],
      "install_cmd": "pip install uvicorn==0.34.0"
    },
    {
      "name": "SQLAlchemy",
      "version": "2.0.36",
      "type": "runtime",
      "required_by": [
        "backend/src/infrastructure/db/base.py",
        "backend/src/infrastructure/db/session.py",
        "backend/src/infrastructure/db/models/master.py",
        "backend/src/infrastructure/db/repositories/base.py",
        "backend/src/infrastructure/db/repositories/master.py"
      ],
      "install_cmd": "pip install SQLAlchemy==2.0.36"
    },
    {
      "name": "psycopg",
      "version": "3.2.3",
      "type": "runtime",
      "required_by": ["backend/src/infrastructure/db/session.py"],
      "install_cmd": "pip install 'psycopg[binary]==3.2.3'"
    },
    {
      "name": "alembic",
      "version": "1.14.0",
      "type": "runtime",
      "required_by": [
        "backend/db/migrations/env.py",
        "backend/db/migrations/versions/0002_master_tables.py"
      ],
      "install_cmd": "pip install alembic==1.14.0"
    },
    {
      "name": "pydantic",
      "version": "2.10.4",
      "type": "runtime",
      "required_by": ["backend/src/presentation/schemas/master.py"],
      "install_cmd": "pip install pydantic==2.10.4"
    },
    {
      "name": "pydantic-settings",
      "version": "2.7.0",
      "type": "runtime",
      "required_by": ["backend/src/config.py"],
      "install_cmd": "pip install pydantic-settings==2.7.0"
    },
    {
      "name": "python-dotenv",
      "version": "1.0.1",
      "type": "runtime",
      "required_by": ["backend/src/config.py"],
      "install_cmd": "pip install python-dotenv==1.0.1"
    },
    {
      "name": "pytest",
      "version": "8.3.4",
      "type": "dev",
      "required_by": ["backend/tests/"],
      "install_cmd": "pip install pytest==8.3.4"
    },
    {
      "name": "pytest-asyncio",
      "version": "0.25.0",
      "type": "dev",
      "required_by": ["backend/tests/"],
      "install_cmd": "pip install pytest-asyncio==0.25.0"
    },
    {
      "name": "httpx",
      "version": "0.28.1",
      "type": "dev",
      "required_by": ["backend/tests/integration/"],
      "install_cmd": "pip install httpx==0.28.1"
    },
    {
      "name": "next",
      "version": "15.1.3",
      "type": "runtime",
      "required_by": ["frontend/src/app/**"],
      "install_cmd": "npm install next@15.1.3"
    },
    {
      "name": "react",
      "version": "19.0.0",
      "type": "runtime",
      "required_by": ["frontend/src/**/*.tsx"],
      "install_cmd": "npm install react@19.0.0"
    },
    {
      "name": "@tanstack/react-query",
      "version": "5.62.7",
      "type": "runtime",
      "required_by": [
        "frontend/src/lib/query/provider.tsx",
        "frontend/src/lib/api/hooks/*.ts",
        "frontend/src/app/admin/**/page.tsx"
      ],
      "install_cmd": "npm install @tanstack/react-query@5.62.7"
    },
    {
      "name": "axios",
      "version": "1.7.9",
      "type": "runtime",
      "required_by": ["frontend/src/lib/api/client.ts"],
      "install_cmd": "npm install axios@1.7.9"
    },
    {
      "name": "react-hook-form",
      "version": "7.54.2",
      "type": "runtime",
      "required_by": [
        "frontend/src/components/admin/**/*Form.tsx"
      ],
      "install_cmd": "npm install react-hook-form@7.54.2"
    },
    {
      "name": "@hookform/resolvers",
      "version": "3.9.1",
      "type": "runtime",
      "required_by": [
        "frontend/src/components/admin/**/*Form.tsx"
      ],
      "install_cmd": "npm install @hookform/resolvers@3.9.1"
    },
    {
      "name": "zod",
      "version": "3.24.1",
      "type": "runtime",
      "required_by": [
        "frontend/src/lib/validation/master-schemas.ts"
      ],
      "install_cmd": "npm install zod@3.24.1"
    },
    {
      "name": "lucide-react",
      "version": "0.469.0",
      "type": "runtime",
      "required_by": [
        "frontend/src/app/admin/layout.tsx",
        "frontend/src/components/admin/MasterDataTable.tsx"
      ],
      "install_cmd": "npm install lucide-react@0.469.0"
    }
  ],
  "services": [
    {
      "name": "PostgreSQL",
      "version": "16",
      "required_by": [
        "backend/src/infrastructure/db/session.py",
        "backend/db/migrations/**"
      ],
      "setup_notes": "Already declared in docker-compose.yml as 'db' service. PO must run `docker-compose up -d db` once. Database `jayanth_trading` and role `trading_app` are auto-provisioned by docker env + bootstrap.sql at first container start."
    }
  ],
  "env_vars": [
    {
      "name": "DATABASE_URL",
      "required": true,
      "description": "SQLAlchemy connection string for the backend app role. Format: postgresql+psycopg://trading_app:<pw>@<host>:5432/jayanth_trading",
      "example": "postgresql+psycopg://trading_app:changeme@localhost:5432/jayanth_trading"
    },
    {
      "name": "DB_PASSWORD",
      "required": true,
      "description": "Password for the trading_app role; consumed by docker-compose.yml and mirrored into DATABASE_URL.",
      "example": "changeme"
    },
    {
      "name": "API_CORS_ORIGINS",
      "required": false,
      "description": "Comma-separated list of allowed CORS origins for the FastAPI backend. Defaults to http://localhost:3000 in dev.",
      "example": "http://localhost:3000"
    },
    {
      "name": "API_ENV",
      "required": false,
      "description": "Runtime environment label (development|production). Toggles docs exposure and log verbosity.",
      "example": "development"
    },
    {
      "name": "NEXT_PUBLIC_API_URL",
      "required": true,
      "description": "Base URL the Next.js client uses to call the FastAPI backend.",
      "example": "http://localhost:8000/api/v1"
    }
  ],
  "migrations": [
    "backend/db/migrations/versions/0002_master_tables.py"
  ]
}
