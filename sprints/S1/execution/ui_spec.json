  "shared_components": {
    "MasterDataTable": {
      "task_ref": "T-033",
      "file": "frontend/src/components/admin/MasterDataTable.tsx",
      "description": "Generic table used by all 6 admin pages.",
      "type_signature": "MasterDataTable<T extends Record<string, unknown>>",
      "props": {
        "rows": {
          "type": "T[]",
          "required": true,
          "description": "Array of data items to render"
        },
        "columns": {
          "type": "{ key: keyof T; label: string }[]",
          "required": true,
          "description": "Column definitions mapping data keys to display labels"
        },
        "rowKey": {
          "type": "(row: T) => string | number",
          "required": true,
          "description": "Unique key extractor for React rendering"
        },
        "isActive": {
          "type": "(row: T) => boolean",
          "required": true,
          "description": "Returns whether a row is active; used for muted styling"
        },
        "onEdit": {
          "type": "(row: T) => void",
          "required": true,
          "description": "Callback when Edit button clicked"
        },
        "onToggleActive": {
          "type": "(row: T) => void",
          "required": true,
          "description": "Callback when Deactivate/Reactivate button clicked"
        },
        "isLoading": {
          "type": "boolean",
          "required": false,
          "description": "Shows skeleton loader when true"
        }
      },
      "ui_elements": {
        "header_row": "bg-muted/50 text-muted-foreground text-xs uppercase tracking-wider font-medium",
        "body_row_active": "border-b hover:bg-muted/30 transition-colors",
        "body_row_inactive": "border-b opacity-50 bg-muted/10",
        "actions_column": "Actions — right-aligned",
        "edit_button": "variant='ghost' size='sm' with Pencil icon",
        "deactivate_button": "variant='ghost' size='sm' with EyeOff icon + destructive text",
        "reactivate_button": "variant='ghost' size='sm' with Eye icon + text-emerald-600",
        "empty_state": "Centered text 'No records found.' with muted styling p-8",
        "loading_state": "5 Skeleton rows matching column widths"
      },
      "shadcn_deps": [
        "Table",
        "TableHeader",
        "TableBody",
        "TableRow",
        "TableHead",
        "TableCell",
        "Button",
        "Skeleton"
      ],
      "lucide_icons": [
        "Pencil",
        "EyeOff",
        "Eye"
      ],
      "test_ids": {
        "table": "master-data-table",
        "edit_button": "edit-btn-{rowKey}",
        "toggle_button": "toggle-btn-{rowKey}"
      }
    },
