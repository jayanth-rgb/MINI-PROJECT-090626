  "per_entity_pages": {
    "common_pattern": {
      "description": "All 6 admin pages follow the same structure with entity-specific data.",
      "page_header": {
        "layout": "flex items-center justify-between mb-6",
        "title": "<h1> with entity name",
        "add_button": "Button variant='default' with Plus icon + 'Add {Entity}'"
      },
      "state_management": {
        "list_query": "useQuery({ queryKey: ['{entity}'], queryFn: {entity}Api.list })",
        "create_mutation": "useMutation({ mutationFn: {entity}Api.create, onSuccess: invalidateQueries, onError: toast.error })",
        "update_mutation": "useMutation({ mutationFn: (args) => {entity}Api.update(args.id, args.data), onSuccess: invalidateQueries, onError: toast.error })",
        "remove_mutation": "useMutation({ mutationFn: {entity}Api.remove, onSuccess: invalidateQueries, onError: toast.error })",
        "dialog_state": "useState<{ mode: 'create' | 'edit'; data?: T } | null>(null)"
      },
      "toast_behavior": {
        "on_create_success": "toast.success('{Entity} created successfully')",
        "on_update_success": "toast.success('{Entity} updated successfully')",
        "on_deactivate_success": "toast.success('{Entity} deactivated')",
        "on_reactivate_success": "toast.success('{Entity} reactivated')",
        "on_409_error": "toast.error(error.response.data.message || 'Duplicate entry')",
        "on_generic_error": "toast.error('An error occurred. Please try again.')"
      },
      "form_pattern": {
        "hook": "useForm<{Entity}Create>({ resolver: zodResolver({entity}Schema), defaultValues })",
        "form_element": "<form id={formId} onSubmit={handleSubmit(onSubmit)}>",
        "field_layout": "space-y-4",
        "field_pattern": "<div><Label htmlFor='{field}'>{Label}</Label><Input id='{field}' {...register('{field}')} />{errors.{field} && <p className='text-sm text-destructive mt-1'>{errors.{field}.message}</p>}</div>",
        "form_id_convention": "{entity}-form"
      }
    },
