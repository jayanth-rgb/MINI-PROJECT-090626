        "header": "DialogTitle text-lg font-semibold",
        "description": "DialogDescription sr-only (accessibility)",
        "body": "px-6 py-4",
        "footer": "flex justify-end gap-3 px-6 py-4 border-t bg-muted/30",
        "cancel_button": "variant='outline'",
        "save_button": "variant='default' type='submit' form={formId}; disabled + loader when isSubmitting"
      },
      "shadcn_deps": [
        "Dialog",
        "DialogContent",
        "DialogHeader",
        "DialogTitle",
        "DialogDescription",
        "DialogFooter",
        "Button"
      ],
      "lucide_icons": [
        "Loader2"
      ],
      "test_ids": {
        "dialog": "master-form-dialog",
        "save_button": "dialog-save-btn",
        "cancel_button": "dialog-cancel-btn"
      }
    }
